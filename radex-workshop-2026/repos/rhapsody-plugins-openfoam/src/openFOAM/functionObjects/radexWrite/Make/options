RADEX_INCLUDE_DIR ?=
RADEX_LIB_DIR ?=
DRAGON_LIBS ?=
DRAGON_LIB_DIR ?=
DRAGON_INCLUDES ?=
SMARTREDIS_INCLUDE_DIR ?=
SMARTREDIS_LIB_DIR ?=

EXE_INC = \
    -std=c++17 \
    -I../radexBase/lnInclude \
    -I../../radexIO/lnInclude \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(RADEX_INCLUDE_DIR) \
    -I$(SMARTREDIS_INCLUDE_DIR) \
    $(DRAGON_INCLUDES)

LIB_LIBS = \
    -lfiniteVolume \
    -lmeshTools \
    -L$(FOAM_USER_LIBBIN) \
    -lradexIO \
    -lradexBase \
    -L$(RADEX_LIB_DIR) \
    -lradex \
    -Wl,-rpath,$(RADEX_LIB_DIR) \
    -L$(SMARTREDIS_LIB_DIR) \
    -lsmartredis \
    -Wl,-rpath,$(SMARTREDIS_LIB_DIR) \
    $(DRAGON_LIBS) \
    -Wl,-rpath,$(DRAGON_LIB_DIR)
